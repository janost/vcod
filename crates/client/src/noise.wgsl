fn noise_val(a: i32) -> i32 {
    return i32(NOISE_PERM[u32(a) & 255u]);
}

fn noise_at(x: i32, y: i32, z: i32, t: i32) -> f32 {
    return NOISE_TABLE[noise_val(x + noise_val(y + noise_val(z + noise_val(t))))];
}

// trilinear in x, y, z at one t
fn noise_xyz(i: vec3<i32>, f: vec3<f32>, t: i32) -> f32 {
    let front = mix(
        mix(noise_at(i.x, i.y, i.z, t), noise_at(i.x + 1, i.y, i.z, t), f.x),
        mix(noise_at(i.x, i.y + 1, i.z, t), noise_at(i.x + 1, i.y + 1, i.z, t), f.x),
        f.y,
    );
    let back = mix(
        mix(noise_at(i.x, i.y, i.z + 1, t), noise_at(i.x + 1, i.y, i.z + 1, t), f.x),
        mix(noise_at(i.x, i.y + 1, i.z + 1, t), noise_at(i.x + 1, i.y + 1, i.z + 1, t), f.x),
        f.y,
    );
    return mix(front, back, f.z);
}

fn noise_get4f(p: vec4<f32>) -> f32 {
    let fl = floor(p);
    let i = vec4<i32>(fl);
    let f = p - fl;
    return mix(noise_xyz(i.xyz, f.xyz, i.w), noise_xyz(i.xyz, f.xyz, i.w + 1), f.w);
}
